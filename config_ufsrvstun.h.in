/**
 * @file config_ufsrvstun.h.in
 * @brief CMake configure_file() template -- generates config_ufsrvstun.h at configure time.
 * Configuration defaults for items the user did not pass via -D live in
 * cmake-modules/config_defaults_definitions.cmake
 */

#ifndef CONFIG_UFSRVSTUN_H
#define CONFIG_UFSRVSTUN_H

#define _REENTRANT
#ifndef _GNU_SOURCE
# define _GNU_SOURCE
#endif

#define UFSRVSTUN_DEBUG_BUILD    @UFSRVSTUN_DEBUG_BUILD@   /* 1 for Debug builds, or when a verbosity level is on */
#define UFSRVSTUN_DEBUG_BUILD_L2 @UFSRVSTUN_DEBUG_L2@      /* level-2 verbose tracing */
#define UFSRVSTUN_DEBUG_BUILD_L3 @UFSRVSTUN_DEBUG_L3@      /* level-3 per-object tracing */

// standard HAVE_* probes (preferred over old __VALGRIND_DRD)
#cmakedefine HAVE_VALGRIND
#cmakedefine HAVE_VALGRIND_DRD
#cmakedefine HAVE_VALGRIND_MEMCHECK

#define CONFIG_UFSRVSTUN_CONFIGFILE_ADJUNCT_SCHEMA "@CONFIG_UFSRVSTUN_CONFIGFILE_ADJUNCT_SCHEMA@"
#define CONFIG_CONFIGFILE_DEFAULT_PID_DIR "@CONFIG_CONFIGFILE_DEFAULT_PID_DIR@"

#endif /* CONFIG_UFSRVSTUN_H */
